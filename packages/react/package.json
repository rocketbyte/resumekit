{
  "name": "@resumekit/react",
  "version": "0.1.0",
  "description": "Editable, print-accurate resume templates for React: paginated documents, an in-place editing kit and the typefaces they are set in. Each template loads, with its stylesheet, on first use.",
  "keywords": [
    "resume",
    "cv",
    "react",
    "templates",
    "pdf",
    "editor"
  ],
  "license": "MIT",
  "author": "Starlin Gil Cruz",
  "homepage": "https://github.com/rocketbyte/resumekit/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocketbyte/resumekit.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/rocketbyte/resumekit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/all-templates.js",
    "./src/all-templates.ts"
  ],
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "@resumekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./all-templates": {
      "@resumekit/source": "./src/all-templates.ts",
      "types": "./dist/all-templates.d.ts",
      "default": "./dist/all-templates.js"
    },
    "./document.css": "./dist/document.css",
    "./fonts.css": "./dist/fonts/fonts.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./all-templates": {
        "types": "./dist/all-templates.d.ts",
        "default": "./dist/all-templates.js"
      },
      "./document.css": "./dist/document.css",
      "./fonts.css": "./dist/fonts/fonts.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.lib.json && tsx scripts/copy-assets.ts",
    "dev": "tsx scripts/generate-templates.ts --watch",
    "gallery": "vite --config gallery/vite.config.mts",
    "typecheck": "tsc -b tsconfig.spec.json",
    "test": "vitest run",
    "generate-templates": "tsx scripts/generate-templates.ts",
    "check-templates": "tsx scripts/generate-templates.ts --check",
    "check:package": "rm -rf out-tsc/pack && pnpm pack --pack-destination out-tsc/pack >/dev/null && publint --strict --pack pnpm && attw out-tsc/pack/*.tgz --profile esm-only --exclude-entrypoints ./document.css ./fonts.css ./package.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@resumekit/schema": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
