{
  "name": "@resumekit/react",
  "version": "0.1.0",
  "description": "Editable, paginated resume templates for React: about thirty print-accurate designs, an in-place editing kit, a static renderer and a self-contained export bundle.",
  "keywords": [
    "resume",
    "cv",
    "react",
    "templates",
    "pdf",
    "editor"
  ],
  "license": "MIT",
  "author": "Starlin Gil Cruz",
  "homepage": "https://github.com/rocketbyte/resumekit/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rocketbyte/resumekit.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/rocketbyte/resumekit/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/test-setup.ts",
    "!src/compiler",
    "!src/export",
    "!dist/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "@resumekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./document.css": "./dist/document.css",
    "./fonts.css": "./dist/fonts/fonts.css",
    "./static": {
      "types": "./dist/static/api.d.ts",
      "default": "./dist/static/static.mjs"
    },
    "./static.css": "./dist/static/templates.css",
    "./static/*.css": "./dist/static/templates/*.css",
    "./export/*": "./dist/export-bundle/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./document.css": "./dist/document.css",
      "./fonts.css": "./dist/fonts/fonts.css",
      "./static": {
        "types": "./dist/static/api.d.ts",
        "default": "./dist/static/static.mjs"
      },
      "./static.css": "./dist/static/templates.css",
      "./static/*.css": "./dist/static/templates/*.css",
      "./export/*": "./dist/export-bundle/*",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.lib.json && tsx scripts/copy-assets.ts && vite build --config vite.static.config.mts && tsx --conditions=@resumekit/source scripts/build-static-css.ts && vite build --config vite.export.config.mts",
    "dev": "tsx scripts/generate-templates.ts --watch",
    "gallery": "vite --config gallery/vite.config.mts",
    "typecheck": "tsc -b tsconfig.spec.json",
    "test": "vitest run",
    "generate-templates": "tsx scripts/generate-templates.ts",
    "check-templates": "tsx scripts/generate-templates.ts --check",
    "check:package": "rm -rf out-tsc/pack && pnpm pack --pack-destination out-tsc/pack >/dev/null && publint --strict --pack pnpm && attw out-tsc/pack/*.tgz --profile esm-only --exclude-entrypoints ./document.css ./fonts.css ./static.css ./static/templates.css ./export/bundle.js ./export/bundle.css"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@resumekit/schema": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
