{
  "name": "@cvgs/resume-templates",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./document.css": "./src/document.css",
    "./fonts.css": "./src/fonts/fonts.css",
    "./static": {
      "types": "./src/static/api.ts",
      "import": "./dist-static/static.mjs",
      "default": "./dist-static/static.mjs"
    },
    "./static.css": "./dist-static/templates.css",
    "./static/*.css": "./dist-static/templates/*.css",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "resume-templates",
    "tags": [
      "scope:templates",
      "type:lib"
    ],
    "targets": {
      "build-export": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist-export"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "vite build --config vite.export.config.mts"
          ]
        },
        "dependsOn": [
          "^build"
        ]
      },
      "build-static": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist-static"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "parallel": false,
          "commands": [
            "vite build --config vite.static.config.mts",
            "tsx scripts/build-static-css.ts"
          ]
        },
        "dependsOn": [
          "^build"
        ]
      },
      "gallery": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "vite --config gallery/vite.config.mts"
          ]
        }
      },
      "generate-templates": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "tsx scripts/generate-templates.ts"
          ]
        }
      },
      "check-templates": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/templates/**/*.template.yaml",
          "{projectRoot}/src/templates/**/*.tsx",
          "{projectRoot}/src/compiler/**",
          "{projectRoot}/scripts/**"
        ],
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "tsx scripts/generate-templates.ts --check"
          ]
        }
      },
      "watch-templates": {
        "executor": "nx:run-commands",
        "cache": false,
        "continuous": true,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "tsx scripts/generate-templates.ts --watch"
          ]
        }
      }
    }
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@cvgs/core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "generate-templates": "tsx scripts/generate-templates.ts",
    "watch-templates": "tsx scripts/generate-templates.ts --watch",
    "check-templates": "tsx scripts/generate-templates.ts --check"
  }
}
