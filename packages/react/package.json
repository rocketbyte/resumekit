{
  "name": "@cvgs/resume-templates",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./document.css": "./src/document.css",
    "./fonts.css": "./src/fonts/fonts.css",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "resume-templates",
    "tags": [
      "scope:templates",
      "type:lib"
    ],
    "targets": {
      "build-export": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist-export"
        ],
        "cache": true,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "vite build --config vite.export.config.mts"
          ]
        },
        "dependsOn": [
          "^build"
        ]
      },
      "gallery": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "vite --config gallery/vite.config.mts"
          ]
        }
      }
    }
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@cvgs/core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
